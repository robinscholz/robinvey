{
  "name": "@robinscholz/robinvey",
  "private": true,
  "description": "Robin Vey’s personal website and CV, and a Wunschzettel for the family: two Nuxt apps generated as static sites from Nuxt Content, the site on mirror v2 and vue-equipment with the CV at /cv.pdf",
  "contributors": [
    {
      "name": "Robin Vey",
      "url": "https://github.com/robinscholz"
    }
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:personal": "turbo run dev --filter=@robinscholz/personal",
    "start:personal": "turbo run start --filter=@robinscholz/personal",
    "deploy:personal": "turbo run deploy --filter=@robinscholz/personal",
    "dev:wunschzettel": "turbo run dev --filter=@robinscholz/wunschzettel",
    "start:wunschzettel": "turbo run start --filter=@robinscholz/wunschzettel",
    "deploy:wunschzettel": "turbo run deploy --filter=@robinscholz/wunschzettel",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,mjs,vue,css,json,jsonc,md,yml}\"",
    "db:generate": "pnpm --filter @robinscholz/database generate",
    "db:studio": "pnpm --filter @robinscholz/database studio",
    "preinstall": "npx only-allow pnpm",
    "uninstall": "pnpm dlx rimraf --glob ./**/node_modules --glob ./**/pnpm-lock.yaml",
    "update:deps": "pnpm dlx taze -r -w",
    "update:deps:major": "pnpm dlx taze major -r -w"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maas/config": "^1.16.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@turbo/gen": "^2.8.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.9",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.6.2"
}
