# `nuxt dev` and `wrangler dev` both read this file. On Cloudflare, set each
# value with `wrangler secret put <NAME>` instead.

# Overrides the public origin, https://wunschzettel.robinvey.com by default,
# for a preview deploy. The bookmarklet opens the add page on it.
NUXT_PUBLIC_SITE_URL=

# GitHub sign-in for adding and removing wishes. `nuxt dev` stays open and
# writes its own session password. See “Sign in” in the README.
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GITHUB_REDIRECT_URL=
NUXT_ALLOWED_GITHUB_IDS=
