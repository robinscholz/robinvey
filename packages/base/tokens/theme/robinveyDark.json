{
  "app": {
    "color": {
      "surface": {
        "bg": {
          "base": {
            "$value": "{config.color.palette.stone.solid.15}",
            "$type": "color"
          },
          "low": {
            "$value": "oklch(0.16 0.003 106)",
            "$type": "color"
          }
        },
        "fg": {
          "default": {
            "$value": "{config.color.palette.stone.solid.1}",
            "$type": "color"
          },
          "muted": {
            "$value": "{config.color.palette.stone.solid.7}",
            "$type": "color"
          },
          "subtle": {
            "$value": "{config.color.palette.stone.solid.11}",
            "$type": "color"
          }
        }
      },
      "component": {
        "shadow": {
          "default": {
            "$value": "oklch(0% 0 none / 0.7)",
            "$type": "color"
          },
          "strong": {
            "$value": "oklch(0% 0 none / 0.7)",
            "$type": "color"
          }
        }
      }
    },
    "boxShadow": {
      "component": {
        "default": {
          "$value": {
            "color": "{app.color.component.shadow.default}",
            "offsetX": "0px",
            "offsetY": "2rem",
            "blur": "4rem",
            "spread": "0px"
          },
          "$type": "shadow"
        }
      }
    }
  }
}
