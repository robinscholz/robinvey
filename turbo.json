{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "globalPassThroughEnv": ["CLOUDFLARE_*"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "tokens": {
      "dependsOn": ["^tokens"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "tokens"],
      "env": ["NUXT_PUBLIC_SITE_URL"],
      "outputs": [".output/**"]
    },
    "dev": {
      "dependsOn": ["tokens", "db:pull"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build", "db:pull"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:pull": {
      "dependsOn": ["db:migrate"],
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["transit"]
    }
  }
}
